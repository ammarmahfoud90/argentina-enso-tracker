# Environment
.env
*.env
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Data — heavy files excluded by default, lightweight NOAA index files tracked
#
# Use data/raw/* (not data/raw/) so git descends into the directory and
# negation patterns below take effect.  A trailing-slash rule on a directory
# prevents git from evaluating any ! overrides inside it.
data/raw/*
data/processed/*
*.nc
*.nc4
*.h5
*.hdf5
*.pkl

# Un-ignore the three small NOAA CPC ASCII index files.
# These are committed so the auto-refresh workflow can update them in-place.
!data/raw/oni.ascii.txt
!data/raw/nino34.ascii.txt
!data/raw/soi.txt

# Un-ignore processed correlation cache
!data/processed/correlations.parquet

# Streamlit
.streamlit/secrets.toml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
