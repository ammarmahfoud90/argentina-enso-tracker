# Copy this file to .env and fill in values
# ERA5 / Copernicus CDS credentials (only needed to regenerate validation cache)
# Register at: https://cds.climate.copernicus.eu/
CDS_URL=https://cds.climate.copernicus.eu/api/v2
CDS_KEY=your-uid:your-api-key

# Optional: contact email shown in disclaimer
CONTACT_EMAIL=contacto@example.com

# GitHub repo URL shown in footer
GITHUB_REPO_URL=https://github.com/yourusername/argentina-enso-tracker
